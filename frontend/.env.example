# ── Backend API (optional — frontend works without it) ──
VITE_API_URL=http://localhost:8000

# ── Google OAuth (optional — for "Continue with Google" button) ──
# Get this from: https://console.cloud.google.com
# 1. Create project → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID → Web Application
# 3. Add Authorised JS origin: http://localhost:5173
# 4. Paste the Client ID below
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ── GitHub API (optional — for direct API calls from frontend) ──
VITE_GITHUB_API_BASE=https://api.github.com

# ── Application Settings ──
VITE_APP_NAME=CodeCognition AI
VITE_APP_VERSION=1.0.0
